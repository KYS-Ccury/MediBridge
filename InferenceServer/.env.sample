# =====================================================
# MediBridge InferenceServer — 환경변수 샘플
# =====================================================
# 사용:
#   cp .env.sample .env
#   # 실제 값 채워 넣기 (시크릿)
#   set -a; source .env; set +a    # 또는 systemd 서비스 단위 환경변수
# =====================================================

# ----- HTTP 서버 -----
MEDIBRIDGE_INFERENCE_PORT=8002

# ----- LLM Provider (ollama | openai | auto) -----
# - ollama : 로컬 Ollama 만 사용. 외부 송신 X. Fallback 없음.
# - openai : OpenAI API 만 사용. 인터넷 의존. Fallback 없음.
# - auto   : OpenAI 우선 + 실패 시 자동 Ollama fallback (단일 백엔드 장애 회복).
MEDIBRIDGE_LLM_BACKEND=ollama

# OpenAI (backend=openai 또는 auto 일 때 필요)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (backend=ollama 또는 auto 일 때 필요)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# 공통
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_MS=8000

# ----- 임베딩 (한국어 특화) -----
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_DEVICE=cuda

# ----- 벡터 DB (Chroma) -----
CHROMA_PERSIST_DIR=./chroma_db

# ----- (선택) Vision 가중치 — 인효 담당 -----
# MEDIBRIDGE_YOLO_WEIGHTS=Models/yolo26_pills.pt
