# =============================================================
# MediBridge 프로젝트 .gitignore
# =============================================================
# ⚠ git의 .gitignore 는 inline 주석(`pattern  # comment`)을 지원하지 않음.
# 주석은 반드시 별도 줄에. 패턴 줄에는 패턴만.
# =============================================================

# ─────────────────────────────────────────────
# Qt / C++ 빌드 산출물 (모든 하위 디렉토리 포함)
# ─────────────────────────────────────────────
build/
**/build/
build-*/
**/build-*/
cmake-build-*/
**/cmake-build-*/
out/

# CMake 자동 생성 산출물
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake

# 컴파일 산출물
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Qt 자동 생성 파일
*.user
*.user.*
*.user.lock
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Qt Creator 사용자별 설정
.qtcreator/
**/.qtcreator/

# ─────────────────────────────────────────────
# Python (InferenceServer, TrainingServer)
# ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.tox/
*.egg-info/
dist/
.coverage

# Python 가상환경
venv/
.venv/
env/

# ─────────────────────────────────────────────
# IDE / 에디터
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# AI 모델 가중치 / 데이터셋
# ─────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.weights
*.h5
*.ckpt
*.tflite

# 데이터셋 (학습 서버 전용)
TrainingServer/Datasets/*
!TrainingServer/Datasets/.gitkeep

# ─────────────────────────────────────────────
# 환경 변수 / 시크릿
# ─────────────────────────────────────────────
.env
.env.local
*.secret
secrets/

# ─────────────────────────────────────────────
# 로그 / 임시 파일 / 받은 파일
# ─────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
received_data/
uploaded/

# ─────────────────────────────────────────────
# OS 자동 생성
# ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# ─────────────────────────────────────────────
# 보고서 PDF / 실행 결과 (재생성 가능)
# ─────────────────────────────────────────────
output/
reports/*.pdf
!reports/SAMPLE.pdf

# Claude Code 환경 설정 (사용자 PC 로컬)
.claude/

# ─────────────────────────────────────────────
# LLM PC — Chroma 벡터 DB / 임베딩 모델 캐시 / .env
# ─────────────────────────────────────────────
InferenceServer/chroma_db/
InferenceServer/.env
**/chroma_db/
# HuggingFace 모델 캐시 (KURE-v1, bge-m3 등 자동 다운로드)
.cache/huggingface/
hf_cache/
