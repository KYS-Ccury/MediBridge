# MainServer 비밀값 양식 — 이 파일을 복사해 MainServer/.env 로 만들고
# 실제 값을 채우세요.  MainServer/.env 는 .gitignore 로 git 에
# 절대 올라가지 않습니다 (키 유출 방지). .env.example(본 파일,
# 플레이스홀더만)만 저장소에 추적됩니다.
#
# 사용:  cp MainServer/.env.example MainServer/.env
#        # 편집기로 MainServer/.env 의 값을 실제 키로 교체
#        # medibridge-up-prod.sh 가 기동 시 자동 로드함
#
# ⚠ 절대 이 .env.example 에 실제 키를 적지 마세요(추적됨).
#    실제 키는 오직 MainServer/.env 에만.

# 식약처 의약품 낱알식별/e약은요 OpenAPI 인증키 (data.go.kr 15057639)
# data.go.kr 활용신청 후 발급된 '일반 인증키(Decoding)' 값을 넣으세요.
MEDIBRIDGE_PDMA_KEY=PUT_YOUR_DATA_GO_KR_SERVICE_KEY_HERE

# (선택) e약은요 캐시 TTL(일). 기본 30.
# MEDIBRIDGE_PDMA_CACHE_TTL_DAYS=30
